# Safe default: simulation only. This repo intentionally runs only t1_late.
DRY_RUN=1

# Required only when DRY_RUN=0.
PRIVATE_KEY=
DEPOSIT_WALLET_ADDRESS=
SIGNATURE_TYPE=3

# Polymarket endpoints.
CLOB_API_URL=https://clob.polymarket.com
CLOB_V2_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
MARKET_SLUG_PREFIX=btc-updown-5m

# Runtime files.
DATA_DIR=data
SIGNAL_FILE=data/t1_late_signals.jsonl
STATE_FILE=data/t1_late_state.json
POLL_MS=200

# T-1 late-entry taker strategy.
T1_LATE_CONFIRM1_SECS=10
T1_LATE_CONFIRM2_SECS=8
T1_LATE_ENTRY_SECS=1
T1_LATE_CONFIRM_MIN_ASK=0.98
T1_LATE_ENTRY_MIN_ASK=0.75
T1_LATE_OPP_MAX_ASK=0.30
T1_LATE_TARGET_QTY=2000

# Historical dry-run bankroll mode.
# 1 = max deploy is current dry-run equity; 0.25 = use 25% of current dry-run equity.
T1_LATE_START_EQUITY=300
T1_LATE_RISK_FRACTION=1

# 0 = no fixed cap. Set 300 to test the fixed 300u cap variant.
T1_LATE_MAX_DEPLOY_USDC=0

# Tail orderbook fallback. Used only near T-10/T-8/T-1 when WS cache has no ask.
REST_FALLBACK_TIMEOUT_MS=700
