# Safe default: simulation only.
DRY_RUN=1

# Strategy:
# btc_oracle_fallback = Candidate B, BTC 涨跌幅 + ask 盈亏比分层，T-8/T-5/T-3 fallback。
# btc_distance_ladder = BTC distance ladder, T-60/T-5 taker strategy; tail disabled by default.
# btc_distance_tail = BTC distance to market open, T-2/T-1 taker dry-run strategy.
# t1_late = old T-10/T-8/T-1 orderbook-confirm strategy.
STRATEGY=btc_oracle_fallback

# Required only when DRY_RUN=0.
PRIVATE_KEY=
DEPOSIT_WALLET_ADDRESS=
SIGNATURE_TYPE=3

# Polymarket endpoints.
CLOB_API_URL=https://clob.polymarket.com
CLOB_V2_API_URL=https://clob.polymarket.com
GAMMA_API_URL=https://gamma-api.polymarket.com
MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
MARKET_SLUG_PREFIX=btc-updown-5m

# Polymarket RTDS BTC price stream.
BTC_PRICE_WS_URL=wss://ws-live-data.polymarket.com
BTC_PRICE_TOPIC=crypto_prices_chainlink
BTC_PRICE_TYPE=*
BTC_PRICE_FILTERS='{"symbol":"btc/usd"}'
BTC_PRICE_SYMBOL=btc/usd
BTC_PRICE_MAX_AGE_MS=3000

# Runtime files.
DATA_DIR=data
SIGNAL_FILE=data/t1_late_signals.jsonl
STATE_FILE=data/t1_late_state.json
POLL_MS=200

# Old T-1 late-entry taker strategy. Used only when STRATEGY=t1_late.
T1_LATE_CONFIRM1_SECS=10
T1_LATE_CONFIRM2_SECS=8
T1_LATE_ENTRY_SECS=1
T1_LATE_CONFIRM_MIN_ASK=0.98
T1_LATE_ENTRY_MIN_ASK=0.75
T1_LATE_OPP_MAX_ASK=0.30

# Shared target quantity and bankroll model.
T1_LATE_TARGET_QTY=5000

# Historical dry-run bankroll mode.
# 1 = max deploy is current dry-run equity; 0.25 = use 25% of current dry-run equity.
T1_LATE_START_EQUITY=300
T1_LATE_RISK_FRACTION=0.2

# 255 = no-tail cap255 backtest hard cap. 0 = no fixed cap.
T1_LATE_MAX_DEPLOY_USDC=255

# BTC oracle fallback Candidate B. Used only when STRATEGY=btc_oracle_fallback.
# Backtest:
# 300u -> 10027.39u, avg/day +313.79u, worst day -282.14u, MDD 866.25u.
# Profile format: semicolon-separated tiers; each tier uses key=value pairs.
# sec = exact seconds before close to check; bps = abs BTC move from market open;
# ask = selected side max ask; spread = max ask-bid spread or none; frac = max fraction of per-market budget.
BTC_ORACLE_PROFILE=label=e8_strong,sec=8,bps=5,ask=0.95,spread=none,frac=1;label=e8_normal,sec=8,bps=0.5,ask=0.93,spread=none,frac=0.75;label=e5_strong,sec=5,bps=1.5,ask=0.98,spread=0.10,frac=1;label=e5_cheap,sec=5,bps=0.2,ask=0.85,spread=0.10,frac=0.75;label=e3_final,sec=3,bps=0,ask=0.95,spread=none,frac=1

# Candidate B bankroll controls.
BTC_ORACLE_RISK_FRACTION=0.25
BTC_ORACLE_MAX_DEPLOY_USDC=270
BTC_ORACLE_DAILY_TAKE_PROFIT=800

# BTC distance tail strategy. Used only when STRATEGY=btc_distance_tail.
BTC_DISTANCE_TAIL_MAX_SECS=2
BTC_DISTANCE_START_CAPTURE_MIN_SECS=295
BTC_DISTANCE_MAX_ASK=0.99
BTC_DISTANCE_MAX_SPREAD=0.10
BTC_DISTANCE_EXCLUDE_ASK_LOW=0.85
BTC_DISTANCE_EXCLUDE_ASK_HIGH=0.90
BTC_DISTANCE_MIN_ABS_BPS=0

# BTC distance ladder strategy. Used only when STRATEGY=btc_distance_ladder.
# early: from T-60, only extreme BTC distance, up to 5% of per-market deploy.
BTC_LADDER_EARLY_SECS=60
BTC_LADDER_EARLY_BUDGET_FRAC=0.05
BTC_LADDER_EARLY_MIN_ABS_BPS=10
BTC_LADDER_EARLY_MIN_SCORE=2.5
BTC_LADDER_EARLY_MAX_ASK=0.95
BTC_LADDER_EARLY_MAX_SPREAD=0.10

# mid: from T-5, BTC distance still strong, up to 100% of per-market deploy.
BTC_LADDER_MID_SECS=5
BTC_LADDER_MID_BUDGET_FRAC=1.0
BTC_LADDER_MID_MIN_ABS_BPS=1
BTC_LADDER_MID_MIN_SCORE=0.5
BTC_LADDER_MID_MAX_ASK=0.99
BTC_LADDER_MID_MAX_SPREAD=0.10
BTC_LADDER_MID_EXCLUDE_ASK_LOW=0.85
BTC_LADDER_MID_EXCLUDE_ASK_HIGH=0.90

# tail: disabled by default with max ask 0.01; raise this only for T-2/T-1 experiments.
BTC_LADDER_TAIL_SECS=2
BTC_LADDER_TAIL_BUDGET_FRAC=1.0
BTC_LADDER_TAIL_MIN_ABS_BPS=0
BTC_LADDER_TAIL_MIN_SCORE=0
BTC_LADDER_TAIL_MAX_ASK=0.01
BTC_LADDER_TAIL_MAX_SPREAD=0.10
BTC_LADDER_TAIL_EXCLUDE_ASK_LOW=0.85
BTC_LADDER_TAIL_EXCLUDE_ASK_HIGH=0.90

# Tail orderbook fallback. Used only near T-10/T-8/T-1 when WS cache has no ask.
REST_FALLBACK_TIMEOUT_MS=700
